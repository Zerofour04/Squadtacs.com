---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Squad Weapons" description="Complete Squad weapons wiki and database. Stats, damage values, and ballistics for rifles, machine guns, launchers, and explosives.">
  <div class="mb-10">
    <h1 class="font-display text-4xl font-bold text-text mb-3 uppercase tracking-wide">Weapons</h1>
    <p class="text-text-muted text-lg">All weapons in Squad</p>
  </div>

  <div class="p-12 bg-bg-card rounded-lg border border-border text-center">
    <div class="w-20 h-20 mx-auto mb-6 rounded-full bg-amber-500/10 flex items-center justify-center">
      <svg class="w-10 h-10 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
    </div>
    <h2 class="font-display text-2xl uppercase tracking-wide text-text mb-3">Coming Soon</h2>
    <p class="text-text-muted max-w-md mx-auto">Detailed weapon stats, damage values, and ballistics data for all Squad weapons are currently being compiled.</p>
  </div>
</BaseLayout>
