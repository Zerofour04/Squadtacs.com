          <span class="px-2 py-0.5 bg-accent/20 text-accent rounded text-xs">Max 4/team</span>
          <span class="text-text-muted">Unlock: 1st@10, 2nd@20, 3rd@30, 4th@40 players</span>
        </div>
      </div>
    </div>

    <!-- Specialist Roles -->
    <div>
      <h3 class="text-lg font-semibold text-accent mb-3">Specialist Roles</h3>
      <div class="space-y-2">
        <div class="p-3 bg-bg-card rounded border border-border/50 flex flex-wrap items-center gap-2 text-sm">
          <span class="font-semibold text-text">Sniper</span>
          <span class="px-2 py-0.5 bg-red-500/20 text-red-400 rounded text-xs">Max 2/team</span>
          <span class="px-2 py-0.5 bg-yellow-500/20 text-yellow-400 rounded text-xs">1/squad</span>
          <span class="text-text-muted">Unlock: 1st@15, 2nd@20 players</span>
        </div>
        <div class="p-3 bg-bg-card rounded border border-border/50 flex flex-wrap items-center gap-2 text-sm">
          <span class="font-semibold text-text">Machine Gunner</span>
          <span class="px-2 py-0.5 bg-red-500/20 text-red-400 rounded text-xs">Max 2/team</span>
          <span class="px-2 py-0.5 bg-yellow-500/20 text-yellow-400 rounded text-xs">1/squad</span>
          <span class="text-text-muted">Unlock: 1st@15, 2nd@20 players</span>
        </div>
        <div class="p-3 bg-bg-card rounded border border-border/50 flex flex-wrap items-center gap-2 text-sm">
          <span class="font-semibold text-text">Heavy Anti-Tank (primary)</span>
          <span class="px-2 py-0.5 bg-red-500/20 text-red-400 rounded text-xs">Max 1/team</span>
          <span class="px-2 py-0.5 bg-yellow-500/20 text-yellow-400 rounded text-xs">1/squad</span>
          <span class="text-text-muted">Unlock: @15 players</span>
        </div>
        <div class="p-3 bg-bg-card rounded border border-border/50 flex flex-wrap items-center gap-2 text-sm">
          <span class="font-semibold text-text">Heavy Anti-Tank (secondary)</span>
          <span class="px-2 py-0.5 bg-red-500/20 text-red-400 rounded text-xs">Max 1/team</span>
          <span class="px-2 py-0.5 bg-yellow-500/20 text-yellow-400 rounded text-xs">1/squad</span>
          <span class="text-text-muted">Unlock: @20 players</span>
        </div>
        <div class="p-3 bg-bg-card rounded border border-border/50 flex flex-wrap items-center gap-2 text-sm">
          <span class="font-semibold text-text">Combat Engineer</span>
          <span class="px-2 py-0.5 bg-red-500/20 text-red-400 rounded text-xs">Max 2/team</span>
          <span class="px-2 py-0.5 bg-yellow-500/20 text-yellow-400 rounded text-xs">1/squad</span>
          <span class="text-text-muted">Unlock: 1st@15, 2nd@20 players</span>
        </div>
        <div class="p-3 bg-bg-card rounded border border-border/50 flex flex-wrap items-center gap-2 text-sm">
          <span class="font-semibold text-text">Sapper</span>
          <span class="px-2 py-0.5 bg-accent/20 text-accent rounded text-xs">Max 4/team</span>
          <span class="px-2 py-0.5 bg-yellow-500/20 text-yellow-400 rounded text-xs">1/squad</span>
          <span class="text-text-muted">Unlock: 1st@5, 2nd@10, 3rd@15, 4th@20 players</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Tips -->
  <section class="mb-12 p-4 bg-bg-card rounded-lg border border-border">
    <h3 class="font-semibold text-text mb-2">Tip</h3>
    <p class="text-text-muted text-sm">If you mouse-over the symbols in the Role tab, you will see a tooltip with details about each role as well as the reason, if any, why that role is unavailable.</p>
  </section>

  <!-- Best Practice -->
  <section class="mb-12 p-6 bg-accent/10 rounded-lg border border-accent/30">
    <h2 class="font-display text-2xl font-bold text-text mb-4 uppercase">Best Practice - Role Priority</h2>
    <ol class="space-y-3 text-text-muted">
      <li class="flex items-start gap-3">
        <span class="flex-shrink-0 w-6 h-6 bg-accent text-bg rounded-full flex items-center justify-center text-sm font-bold">1</span>
        <div><span class="text-text font-semibold">Squad Leader</span> - Every squad should have one to deploy assets and rallies.</div>
      </li>
      <li class="flex items-start gap-3">
        <span class="flex-shrink-0 w-6 h-6 bg-accent text-bg rounded-full flex items-center justify-center text-sm font-bold">2</span>
        <div><span class="text-text font-semibold">Medic</span> - Extends squad longevity on the battlefield. Reduces ticket loss.</div>
      </li>
      <li class="flex items-start gap-3">
        <span class="flex-shrink-0 w-6 h-6 bg-accent text-bg rounded-full flex items-center justify-center text-sm font-bold">3</span>
        <div><span class="text-text font-semibold">LAT / HAT</span> - Essential on vehicle-heavy maps. HAT kits should always be claimed.</div>
      </li>
      <li class="flex items-start gap-3">
        <span class="flex-shrink-0 w-6 h-6 bg-accent text-bg rounded-full flex items-center justify-center text-sm font-bold">4</span>
        <div><span class="text-text font-semibold">Rifleman</span> - Backbone of the squad. Ammo bag supplies the whole squad anywhere.</div>
      </li>
      <li class="flex items-start gap-3">
        <span class="flex-shrink-0 w-6 h-6 bg-accent text-bg rounded-full flex items-center justify-center text-sm font-bold">5</span>
        <div><span class="text-text font-semibold">Fire Support / Specialist</span> - Discuss with your SL based on map and objective.</div>
      </li>
    </ol>
    <p class="mt-4 text-sm text-accent font-semibold">Priority 1 and 2 should always be filled!</p>
  </section>

  <!-- All Roles Section -->
  <section class="mb-8">
    <h2 class="font-display text-2xl font-bold text-text mb-6 uppercase">All Roles</h2>
  </section>

  <div class="grid gap-4">
    {sortedClasses.length > 0 ? (
      sortedClasses.map((cls) => (
        <Card
          title={cls.data.title}
          description={cls.data.description}
          href={`/classes/${cls.id}`}
          badge="Infantry"
          badgeColor="accent"
        />
      ))
    ) : (
      <div class="p-8 bg-bg-card rounded-lg border border-border text-center">
        <p class="text-text-muted mb-2">No classes yet</p>
        <p class="text-sm text-text-dim">Add markdown files to <code class="text-accent">src/content/classes/</code></p>
      </div>
    )}
  </div>
</BaseLayout>
