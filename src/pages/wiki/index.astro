---
import BaseLayout from '../../layouts/BaseLayout.astro';

const categories = [
  {
    title: 'Forces',
    description: 'Playable factions and soldier classes',
    color: 'accent',
    items: [
      {
        name: 'Factions',
        href: '/factions',
        description: 'All playable armies and their equipment',
        icon: '/img/icons/default/infantry/map_genericinfantry.svg',
      },
      {
        name: 'Classes',
        href: '/classes',
        description: 'Infantry roles and their loadouts',
        icon: '/img/icons/default/infantry/map_hat.svg',
      },
    ],
  },
  {
    title: 'Arsenal',
    description: 'Weapons, vehicles, and deployable structures',
    color: 'primary',
    items: [
      {
        name: 'Weapons',
        href: '/weapons',
        description: 'Firearms, launchers, and grenades',
        icon: '/img/icons/default/infantry/map_lat.svg',
      },
      {
        name: 'Vehicles',
        href: '/vehicles',
        description: 'Transports, APCs, IFVs, tanks, and helicopters',
        icon: '/img/icons/default/vehicles/map_tank.svg',
      },
    ],
  },
  {
    title: 'Gameplay',
    description: 'Game rules, modes, and mechanics',
    color: 'blufor',
    items: [
      {
        name: 'Game Modes',
        href: '/game-modes',
        description: 'AAS, RAAS, Invasion, Insurgency, and more',
        icon: '/img/icons/default/deployables/deployable_fob.svg',
      },
      {
        name: 'Maps',
        href: '/maps',
        description: 'All playable maps and their layers',
        icon: '/img/icons/default/deployables/rallypoint.svg',
      },
    ],
  },
];

const comingSoon = [
  { name: 'Deployables', description: 'HABs, fortifications, and emplacements', icon: '/img/icons/default/deployables/deployable_hab.svg' },
  { name: 'Ammunition', description: 'AP, HE, HEAT, and fragmentation rounds', icon: '/img/icons/default/deployables/deployable_ammocrate.svg' },
  { name: 'Ticket Values', description: 'Complete ticket cost reference', icon: '/img/icons/default/deployables/deployable_mortars.svg' },
  { name: 'Keybindings', description: 'Full control reference', icon: '/img/icons/default/vehicles/map_jeep.svg' },
];
---

<BaseLayout title="Wiki">
  <div class="mb-10">
    <h1 class="font-display text-4xl font-bold text-text mb-3 uppercase tracking-wide">Wiki</h1>
    <p class="text-text-muted text-lg">Squad reference database - everything you need to know</p>
  </div>

  <!-- Categories -->
  {categories.map((category) => (
    <section class="mb-10">
      <div class="mb-4">
        <h2 class={`font-display text-xl font-bold text-${category.color} mb-1`}>{category.title}</h2>
        <p class="text-text-dim text-sm">{category.description}</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        {category.items.map((item) => (
          <a
            href={item.href}
            class="group flex items-center gap-4 p-4 bg-bg-card/50 hover:bg-bg-card border border-border/50 hover:border-border rounded-lg transition-all"
          >
            <div class="w-12 h-12 bg-bg-hover rounded-lg flex items-center justify-center flex-shrink-0 p-2">
              <img src={item.icon} alt="" class="w-full h-full object-contain opacity-80 group-hover:opacity-100 transition-opacity" />
            </div>
            <div>
              <h3 class="font-display text-lg font-semibold text-text group-hover:text-accent transition-colors">
                {item.name}
              </h3>
              <p class="text-text-muted text-sm">{item.description}</p>
            </div>
          </a>
        ))}
      </div>
    </section>
  ))}

  <!-- Coming Soon -->
  <section class="mt-14">
    <div class="mb-4">
      <h2 class="font-display text-xl font-bold text-text-dim mb-1">Coming Soon</h2>
      <p class="text-text-dim text-sm">More reference content in development</p>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
      {comingSoon.map((item) => (
        <div class="p-3 bg-bg-card/30 border border-border/30 rounded-lg opacity-50">
          <div class="flex items-center gap-2 mb-2">
            <img src={item.icon} alt="" class="w-5 h-5 object-contain opacity-60" />
            <h3 class="font-display text-sm font-medium text-text-muted">{item.name}</h3>
          </div>
          <p class="text-text-dim text-xs">{item.description}</p>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
