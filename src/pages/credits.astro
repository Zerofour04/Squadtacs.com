---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Credits & License" showSidebar={false}>
  <div class="max-w-3xl mx-auto">
    <div class="mb-10">
      <h1 class="font-display text-4xl font-bold text-text mb-3 uppercase tracking-wide">Credits & License</h1>
      <p class="text-text-muted">Acknowledgments and licensing information</p>
    </div>

    <section class="mb-10">
      <h2 class="font-display text-sm uppercase tracking-[0.2em] text-text-dim mb-6 flex items-center gap-3">
        <span class="w-8 h-px bg-border"></span>
        Content Sources
        <span class="flex-1 h-px bg-border"></span>
      </h2>

      <div class="overflow-hidden rounded-lg border border-border">
        <table class="w-full text-sm">
          <thead class="bg-bg-elevated text-left">
            <tr>
              <th class="px-5 py-3 text-text font-semibold">Source</th>
              <th class="px-5 py-3 text-text font-semibold">Content</th>
              <th class="px-5 py-3 text-text font-semibold">License</th>
            </tr>
          </thead>
          <tbody class="text-text-muted">
            <tr class="border-t border-border bg-bg-card">
              <td class="px-5 py-4">
                <a href="https://squad.fandom.com" target="_blank" rel="noopener noreferrer" class="text-primary-light hover:text-accent font-medium">Squad Wiki</a>
              </td>
              <td class="px-5 py-4">Game information, statistics, factual content</td>
              <td class="px-5 py-4">
                <a href="https://creativecommons.org/licenses/by-nc-sa/3.0/" target="_blank" rel="noopener noreferrer" class="text-text-dim hover:text-accent">CC BY-NC-SA</a>
              </td>
            </tr>
            <tr class="border-t border-border bg-bg-card">
              <td class="px-5 py-4">
                <a href="https://github.com/sh4rkman/SquadCalc" target="_blank" rel="noopener noreferrer" class="text-primary-light hover:text-accent font-medium">SquadCalc</a>
                <span class="block text-text-dim text-xs">by sharkman</span>
              </td>
              <td class="px-5 py-4">Icons and assets</td>
              <td class="px-5 py-4">
                <a href="https://github.com/sh4rkman/SquadCalc/blob/master/LICENSE" target="_blank" rel="noopener noreferrer" class="text-text-dim hover:text-accent">MIT (Non-Commercial)</a>
              </td>
            </tr>
            <tr class="border-t border-border bg-bg-card">
              <td class="px-5 py-4">
                <a href="https://steamcommunity.com/sharedfiles/filedetails/?id=3172739937" target="_blank" rel="noopener noreferrer" class="text-primary-light hover:text-accent font-medium">ZenLogic</a>
                <span class="block text-text-dim text-xs">Steam Guide</span>
              </td>
              <td class="px-5 py-4">Vehicle penetration guide</td>
              <td class="px-5 py-4 text-text-dim">Steam Subscriber Agreement</td>
            </tr>
            <tr class="border-t border-border bg-bg-card">
              <td class="px-5 py-4">
                <a href="https://steamcommunity.com/sharedfiles/filedetails/?id=3157599349" target="_blank" rel="noopener noreferrer" class="text-primary-light hover:text-accent font-medium">ExSide</a>
                <span class="block text-text-dim text-xs">Steam Guide</span>
              </td>
              <td class="px-5 py-4">Penetration indicators guide</td>
              <td class="px-5 py-4 text-text-dim">Steam Subscriber Agreement</td>
            </tr>
            <tr class="border-t border-border bg-bg-card">
              <td class="px-5 py-4">
                <a href="https://www.offworldindustries.com" target="_blank" rel="noopener noreferrer" class="text-primary-light hover:text-accent font-medium">Offworld Industries</a>
              </td>
              <td class="px-5 py-4">Game assets, screenshots, trademarks</td>
              <td class="px-5 py-4 text-text-dim">Property of respective owners</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="mb-10">
      <h2 class="font-display text-sm uppercase tracking-[0.2em] text-text-dim mb-6 flex items-center gap-3">
        <span class="w-8 h-px bg-border"></span>
        License
        <span class="flex-1 h-px bg-border"></span>
      </h2>

      <div class="bg-bg-card rounded-lg border border-border p-6">
        <div class="flex items-center gap-4 mb-6 pb-4 border-b border-border/50">
          <img
            src="https://licensebuttons.net/l/by-nc-sa/4.0/88x31.png"
            alt="CC BY-NC-SA License"
            class="h-8"
          />
          <span class="font-display text-text font-semibold uppercase tracking-wide">CC BY-NC-SA 4.0</span>
        </div>

        <p class="text-text-muted mb-6">
          This work is licensed under a
          <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/" target="_blank" rel="noopener noreferrer" class="text-primary-light hover:text-accent transition-colors">
            Creative Commons Attribution-NonCommercial-ShareAlike 4.0 International License
          </a>.
        </p>

        <div class="grid gap-4">
          <div class="flex items-start gap-4 p-3 bg-bg-elevated/50 rounded-lg">
            <img src="https://mirrors.creativecommons.org/presskit/icons/by.svg" alt="BY" class="w-10 h-10 flex-shrink-0" />
            <div>
              <span class="font-medium text-text text-sm">Attribution</span>
              <p class="text-sm text-text-muted">You must give appropriate credit and indicate if changes were made.</p>
            </div>
          </div>
          <div class="flex items-start gap-4 p-3 bg-bg-elevated/50 rounded-lg">
            <img src="https://mirrors.creativecommons.org/presskit/icons/nc.svg" alt="NC" class="w-10 h-10 flex-shrink-0" />
            <div>
              <span class="font-medium text-text text-sm">Non-Commercial</span>
              <p class="text-sm text-text-muted">You may not use the material for commercial purposes.</p>
            </div>
          </div>
          <div class="flex items-start gap-4 p-3 bg-bg-elevated/50 rounded-lg">
            <img src="https://mirrors.creativecommons.org/presskit/icons/sa.svg" alt="SA" class="w-10 h-10 flex-shrink-0" />
            <div>
              <span class="font-medium text-text text-sm">Share-Alike</span>
              <p class="text-sm text-text-muted">If you remix or transform the material, you must distribute under the same license.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="mb-10">
      <h2 class="font-display text-sm uppercase tracking-[0.2em] text-text-dim mb-6 flex items-center gap-3">
        <span class="w-8 h-px bg-border"></span>
        Disclaimer
        <span class="flex-1 h-px bg-border"></span>
      </h2>

      <div class="bg-bg-card rounded-lg border border-border p-6 border-l-4 border-l-independent">
        <p class="text-text-muted">
          This is a fan-made community resource and is not affiliated with, endorsed by, or connected to
          Offworld Industries or any of its subsidiaries. All trademarks and registered trademarks are
          the property of their respective owners.
        </p>
      </div>
    </section>

    <section>
      <h2 class="font-display text-sm uppercase tracking-[0.2em] text-text-dim mb-6 flex items-center gap-3">
        <span class="w-8 h-px bg-border"></span>
        Contributors
        <span class="flex-1 h-px bg-border"></span>
      </h2>

      <div class="bg-bg-card rounded-lg border border-border p-6">
        <p class="text-text-muted mb-4">
          This project is open source. Want to contribute?
        </p>
        <a
          href="#"
          class="inline-flex items-center gap-2 px-5 py-2.5 bg-bg-elevated hover:bg-bg-hover text-text font-display uppercase tracking-wider text-sm rounded-lg border border-border hover:border-primary/50 transition-all"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
          </svg>
          View on GitHub
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
