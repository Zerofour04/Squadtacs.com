---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Maps">
  <div class="mb-10">
    <h1 class="font-display text-4xl font-bold text-text mb-3 uppercase tracking-wide">Maps</h1>
    <p class="text-text-muted text-lg">All maps in Squad</p>
  </div>

  <div class="p-8 bg-bg-card rounded-lg border border-border text-center">
    <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-pac/10 flex items-center justify-center">
      <svg class="w-8 h-8 text-pac" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
      </svg>
    </div>
    <p class="text-text-muted mb-2">No maps yet</p>
    <p class="text-sm text-text-dim">Add markdown files to <code class="text-accent">src/content/maps/</code></p>
  </div>
</BaseLayout>
