---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { vehicleCategories, getVehicleCount } from '../../data/vehicles';

const totalVehicles = getVehicleCount();
---

<BaseLayout title="Squad Vehicles" description="Squad vehicle wiki and tactics guide. Transport trucks, APCs, IFVs, tanks, helicopters - armor values, weapons, and crew requirements.">
  <!-- Hero Section -->
  <div class="mb-12">
    <h1 class="font-display text-4xl font-bold text-text mb-3 uppercase tracking-wide">Vehicles</h1>
    <p class="text-text-muted text-lg max-w-3xl">
      Vehicles are crucial assets in Squad, providing transportation, fire support, and logistics capabilities. From nimble motorbikes to devastating Main Battle Tanks, mastering vehicles is key to victory.
    </p>
    <p class="text-accent mt-2 text-sm">{totalVehicles} vehicles documented</p>
  </div>

  <!-- Vehicle Categories Browser -->
  <section class="mb-12">
    <h2 class="font-display text-2xl font-bold text-text mb-6 uppercase">Browse by Category</h2>

    <div class="space-y-6">
      {vehicleCategories.map((category) => (
        <div class="bg-bg-card rounded-lg border border-border overflow-hidden">
          <!-- Category Header -->
          <div class={`p-4 border-b border-border ${category.colorClass.split(' ')[0]}`}>
            <h3 class="text-xl font-semibold text-text flex items-center gap-3">
              <span class={`w-8 h-8 rounded flex items-center justify-center text-sm font-bold ${category.colorClass}`}>
                {category.name.charAt(0)}
              </span>
              {category.name}
              <span class="text-text-muted text-sm font-normal ml-auto">
                {category.subcategories.reduce((acc, sub) => acc + sub.vehicles.length, 0)} vehicles
              </span>
            </h3>
          </div>

          <!-- Subcategories -->
          <div class="divide-y divide-border/50">
            {category.subcategories.map((subcategory) => (
              <details class="group">
                <summary class="flex items-start gap-4 p-4 cursor-pointer hover:bg-bg/50 transition-colors list-none">
                  <img
                    src={subcategory.icon}
                    alt={subcategory.name}
                    class="w-12 h-12 object-contain flex-shrink-0 mt-1"
                  />
                  <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-2">
                      <h4 class="font-semibold text-text">{subcategory.name}</h4>
                      <span class="text-xs text-text-muted bg-bg px-2 py-0.5 rounded">
                        {subcategory.vehicles.length}
                      </span>
                      <svg
                        class="w-5 h-5 text-text-muted ml-auto transform transition-transform group-open:rotate-180"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                      >
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                      </svg>
                    </div>
                    <p class="text-text-muted text-sm mt-1">{subcategory.description}</p>
                  </div>
                </summary>

                <!-- Vehicle List -->
                <div class="p-4 pt-0">
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-2 mt-4">
                    {subcategory.vehicles.map((vehicle) => (
                      <div class="group/card flex items-center gap-3 bg-bg rounded-lg border border-border/50 hover:border-accent/50 transition-all p-2">
                        {/* Vehicle Image - Clickable for Lightbox */}
                        <button
                          type="button"
                          class="w-20 h-12 flex-shrink-0 bg-bg-card rounded flex items-center justify-center cursor-pointer hover:ring-2 hover:ring-accent/50 transition-all"
                          data-lightbox-trigger
                          data-image={`/img/vehicles/${vehicle.image}`}
                          data-title={vehicle.name}
                        >
                          <img
                            src={`/img/vehicles/${vehicle.image}`}
                            alt={vehicle.name}
                            class="max-w-full max-h-full object-contain pointer-events-none"
                            loading="lazy"
                          />
                        </button>
                        {/* Vehicle Name */}
                        <div class="flex-1 min-w-0">
                          <p class="text-sm text-text truncate group-hover/card:text-accent transition-colors" title={vehicle.name}>
                            {vehicle.name}
                          </p>
                        </div>
                        {/* Faction Flags */}
                        <div class="flex items-center gap-1 flex-shrink-0">
                          {vehicle.factions.slice(0, 3).map((faction) => (
                            <img
                              src={`/img/flags/${faction}.webp`}
                              alt={faction}
                              title={faction}
                              class="w-6 h-6 rounded-sm object-cover"
                              loading="lazy"
                            />
                          ))}
                          {vehicle.factions.length > 3 && (
                            <span class="text-xs text-text-muted" title={vehicle.factions.slice(3).join(', ')}>
                              +{vehicle.factions.length - 3}
                            </span>
                          )}
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              </details>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Gameplay Section -->
  <section class="mb-12 p-6 bg-bg-card rounded-lg border border-border">
    <h2 class="font-display text-2xl font-bold text-text mb-4 uppercase">Gameplay</h2>

    <!-- Entering a Vehicle -->
    <div class="mb-6">
      <h3 class="text-lg font-semibold text-accent mb-3">Entering a Vehicle</h3>
      <p class="text-text-muted mb-3">
        To drive a vehicle, you must first claim the vehicle, then enter the driver's seat and start the engine. To enter, exit, rearm, or switch kits off a vehicle, press and hold <kbd class="px-2 py-1 bg-bg rounded text-accent text-xs">F</kbd>.
      </p>
      <p class="text-text-muted mb-3">
        To switch seats, press <kbd class="px-2 py-1 bg-bg rounded text-accent text-xs">F1</kbd> to <kbd class="px-2 py-1 bg-bg rounded text-accent text-xs">F10</kbd>. For a short moment, you will also see a list of the current passengers of the vehicle.
      </p>
      <div class="p-3 bg-accent/10 rounded border border-accent/30 text-sm text-text-muted">
        <strong class="text-accent">Tip:</strong> Entering or exiting vehicles and switching seats is not instantaneous. This greatly reduces the effectiveness of soloing vehicles when ambushed.
      </div>
    </div>

    <!-- Driving a Vehicle -->
    <div class="mb-6">
      <h3 class="text-lg font-semibold text-accent mb-3">Driving a Vehicle</h3>
      <p class="text-text-muted mb-3">
        To start and turn off the engine, press and hold <kbd class="px-2 py-1 bg-bg rounded text-accent text-xs">E</kbd>. Make sure you have assigned a keyboard key to "Vehicle toggle engine" in the settings menu.
      </p>
      <p class="text-text-muted">
        Squad emulates gears of vehicles. To maintain the current gear, press and hold <kbd class="px-2 py-1 bg-bg rounded text-accent text-xs">Shift</kbd>. This can result in more traction when the vehicle is struggling, and can also limit the speed.
      </p>
    </div>

    <!-- Shooting in a Vehicle -->
    <div>
      <h3 class="text-lg font-semibold text-accent mb-3">Shooting in a Vehicle</h3>
      <p class="text-text-muted mb-3">
        If you are in a gunner seat and your vehicle has zoom mode, zoom in by pressing <kbd class="px-2 py-1 bg-bg rounded text-accent text-xs">Q</kbd>. Some vehicles can stabilize your view by pressing <kbd class="px-2 py-1 bg-bg rounded text-accent text-xs">Z</kbd>.
      </p>
      <p class="text-text-muted">
        The <kbd class="px-2 py-1 bg-bg rounded text-accent text-xs">WASD</kbd> keys control traverse and pitch on most vehicle turrets. Tanks and IFVs have different ammo types: use <span class="text-accent font-semibold">AP rounds</span> against armor and <span class="text-accent font-semibold">HE/HEAT rounds</span> against infantry.
      </p>
    </div>
  </section>

  <!-- Damaging a Vehicle -->
  <section class="mb-12">
    <h2 class="font-display text-2xl font-bold text-text mb-4 uppercase">Damaging a Vehicle</h2>
    <p class="text-text-muted mb-6">Vehicles have defined armor values. The front typically has more armor than the sides and rear. Vehicles also have simulated components:</p>

    <div class="grid md:grid-cols-2 gap-4">
      <div class="p-4 bg-bg-card rounded-lg border border-border">
        <h3 class="font-semibold text-red-400 mb-2">Engine Damage</h3>
        <p class="text-text-muted text-sm">Damaging an engine will result in the vehicle moving extremely slowly.</p>
      </div>
      <div class="p-4 bg-bg-card rounded-lg border border-border">
        <h3 class="font-semibold text-red-400 mb-2">Ammo Compartment</h3>
        <p class="text-text-muted text-sm">Damaging the ammo compartment will result in a "cook off" and full destruction of the vehicle.</p>
      </div>
      <div class="p-4 bg-bg-card rounded-lg border border-border">
        <h3 class="font-semibold text-red-400 mb-2">Tracks/Wheels</h3>
        <p class="text-text-muted text-sm">Destroying tracks prevents movement on that side. Damaged wheels result in loss of traction and control. Repair with a repair toolbox.</p>
      </div>
      <div class="p-4 bg-bg-card rounded-lg border border-border">
        <h3 class="font-semibold text-red-400 mb-2">Turret Damage</h3>
        <p class="text-text-muted text-sm">Below 50% health, turrets suffer movement penalties. A crack appears on-screen at 50%. Repair toolbox can only repair to 25% health.</p>
      </div>
    </div>

    <div class="mt-6 space-y-3">
      <div class="p-4 bg-orange-500/10 rounded-lg border border-orange-500/30">
        <h3 class="font-semibold text-orange-400 mb-2">Burning</h3>
        <p class="text-text-muted text-sm">Vehicles start burning once enough damage is taken. Health ticks down to destruction unless repaired. 2 crewmen may be required to repair simultaneously to stop severe fires. Fire also damages crew with a coughing sound.</p>
      </div>
      <div class="p-4 bg-yellow-500/10 rounded-lg border border-yellow-500/30">
        <h3 class="font-semibold text-yellow-400 mb-2">Unattended Damage</h3>
        <p class="text-text-muted text-sm">Unoccupied vehicles not within 150m of a Rally Point or FOB will start to burn after 20 minutes.</p>
      </div>
    </div>
  </section>

  <!-- Infantry Interaction -->
  <section class="mb-12">
    <h2 class="font-display text-2xl font-bold text-text mb-4 uppercase">Infantry Interaction</h2>
    <div class="grid md:grid-cols-2 gap-6">
      <div class="p-5 bg-bg-card rounded-lg border border-border">
        <h3 class="text-lg font-semibold text-text mb-3">Supplies</h3>
        <p class="text-text-muted text-sm mb-3">
          All vehicles carry some amount of supplies. While the vehicle is stopped, any teammate in or next to the vehicle can load and unload supplies using the radial menu (<kbd class="px-2 py-1 bg-bg rounded text-accent text-xs">F</kbd>).
        </p>
        <p class="text-text-muted text-sm">Multiple players can load/unload faster than a single player.</p>
      </div>
      <div class="p-5 bg-bg-card rounded-lg border border-border">
        <h3 class="text-lg font-semibold text-text mb-3">Resupply & Kit Switch</h3>
        <p class="text-text-muted text-sm mb-3">
          All vehicles carry ammunition for infantry resupply. Resupply and kit-switch is possible on a moving vehicle from the radial menu.
        </p>
        <p class="text-text-muted text-sm">Most vehicles only allow Crewman/Lead Crewman kits. APCs, IFVs, and Transport Helicopters allow any infantry kit.</p>
      </div>
    </div>
  </section>

  <!-- Reset/Recovery -->
  <section class="mb-12 p-6 bg-bg-card rounded-lg border border-border">
    <h2 class="font-display text-2xl font-bold text-text mb-4 uppercase">Vehicle Recovery</h2>
    <p class="text-text-muted mb-4">
      The vehicle recovery/reset system is useful for flipped or stuck vehicles. Access it from outside the vehicle using the radial menu (<kbd class="px-2 py-1 bg-bg rounded text-accent text-xs">F</kbd>).
    </p>
    <div class="grid md:grid-cols-2 gap-4">
      <div class="p-3 bg-bg rounded border border-border/50">
        <span class="text-accent font-semibold">Reset Time:</span>
        <span class="text-text-muted text-sm ml-2">~40 seconds to right a vehicle</span>
      </div>
      <div class="p-3 bg-bg rounded border border-border/50">
        <span class="text-accent font-semibold">Quick Re-reset:</span>
        <span class="text-text-muted text-sm ml-2">~5 seconds if recently righted</span>
      </div>
    </div>
    <p class="text-text-muted text-sm mt-4">
      You can also push certain vehicles like boats and helicopters to get them unstuck from terrain. Vehicles are pushed in the direction between your character center and the vehicle center.
    </p>
  </section>

  <!-- Physics -->
  <section class="mb-12">
    <h2 class="font-display text-2xl font-bold text-text mb-4 uppercase">Physics</h2>
    <p class="text-text-muted mb-4">Different surfaces provide different amounts of traction and rolling resistance (Physmat). Wheeled vehicles are more affected than tracked vehicles.</p>

    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="bg-bg-card border-b border-border">
            <th class="p-3 text-left text-text font-semibold">Surface Type</th>
            <th class="p-3 text-center text-text font-semibold">Resistance</th>
          </tr>
        </thead>
        <tbody class="text-text-muted">
          <tr class="border-b border-border/30 hover:bg-bg-card/50">
            <td class="p-3">Asphalt, Concrete, Solid Wood</td>
            <td class="p-3 text-center"><span class="text-green-400">Lowest</span></td>
          </tr>
          <tr class="border-b border-border/30 hover:bg-bg-card/50">
            <td class="p-3">Gravel</td>
            <td class="p-3 text-center"><span class="text-green-300">Low</span></td>
          </tr>
          <tr class="border-b border-border/30 hover:bg-bg-card/50">
            <td class="p-3">Dirt, Grass</td>
            <td class="p-3 text-center"><span class="text-yellow-400">Medium</span></td>
          </tr>
          <tr class="border-b border-border/30 hover:bg-bg-card/50">
            <td class="p-3">Sand, Snow</td>
            <td class="p-3 text-center"><span class="text-orange-400">High</span></td>
          </tr>
          <tr class="hover:bg-bg-card/50">
            <td class="p-3">Mud</td>
            <td class="p-3 text-center"><span class="text-red-400">Highest</span></td>
          </tr>
        </tbody>
      </table>
    </div>

    <div class="mt-4 p-3 bg-bg-card rounded border border-border text-sm text-text-muted">
      <strong class="text-text">Ricochets:</strong> Missed shots have a chance to ricochet depending on angle. Ricocheted shots don't deal damage but indicate non-penetration. Tracer rounds will follow ricochets.
    </div>
  </section>

  <!-- Legend -->
  <section class="mb-12">
    <h2 class="font-display text-2xl font-bold text-text mb-4 uppercase">Vehicle Stats Legend</h2>
    <p class="text-text-muted mb-6">When viewing vehicle statistics, you'll encounter these indicators:</p>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
      <div class="p-4 bg-bg-card rounded-lg border border-border">
        <div class="flex items-center gap-3 mb-2">
          <div class="w-10 h-10 bg-accent/20 rounded flex items-center justify-center">
            <svg class="w-5 h-5 text-accent" fill="currentColor" viewBox="0 0 20 20">
              <path d="M10 2a8 8 0 100 16 8 8 0 000-16zm1 11H9v-2h2v2zm0-4H9V5h2v4z"/>
            </svg>
          </div>
          <h3 class="font-semibold text-text">Ammo Capacity</h3>
        </div>
        <p class="text-text-muted text-sm">Many non-logistical vehicles carry a small amount of ammo points to resupply troops in the field.</p>
      </div>
      <div class="p-4 bg-bg-card rounded-lg border border-border">
        <div class="flex items-center gap-3 mb-2">
          <div class="w-10 h-10 bg-green-500/20 rounded flex items-center justify-center">
            <svg class="w-5 h-5 text-green-400" fill="currentColor" viewBox="0 0 20 20">
              <path d="M4 3a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V5a2 2 0 00-2-2H4zm3 2h6v4H7V5zm8 8v2h-2v-2h2zm-4 0v2H7v-2h4z"/>
            </svg>
          </div>
          <h3 class="font-semibold text-text">Supply Capacity</h3>
        </div>
        <p class="text-text-muted text-sm">Total amount of Ammo and Construction points a logistics vehicle can carry combined.</p>
      </div>
      <div class="p-4 bg-bg-card rounded-lg border border-border">
        <div class="flex items-center gap-3 mb-2">
          <div class="w-10 h-10 bg-blue-500/20 rounded flex items-center justify-center">
            <svg class="w-5 h-5 text-blue-400" fill="currentColor" viewBox="0 0 20 20">
              <path d="M9 6a3 3 0 11-6 0 3 3 0 016 0zM17 6a3 3 0 11-6 0 3 3 0 016 0zM12.93 17c.046-.327.07-.66.07-1a6.97 6.97 0 00-1.5-4.33A5 5 0 0119 16v1h-6.07zM6 11a5 5 0 015 5v1H1v-1a5 5 0 015-5z"/>
            </svg>
          </div>
          <h3 class="font-semibold text-text">Crew + Capacity</h3>
        </div>
        <p class="text-text-muted text-sm">Maximum amount of crewmen/pilots and soldiers that can occupy the vehicle.</p>
      </div>
      <div class="p-4 bg-bg-card rounded-lg border border-border">
        <div class="flex items-center gap-3 mb-2">
          <div class="w-10 h-10 bg-red-500/20 rounded flex items-center justify-center">
            <svg class="w-5 h-5 text-red-400" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M5 2a2 2 0 00-2 2v14l3.5-2 3.5 2 3.5-2 3.5 2V4a2 2 0 00-2-2H5zm4.707 5.707a1 1 0 00-1.414-1.414L7 7.586l-.293-.293a1 1 0 00-1.414 1.414l1 1a1 1 0 001.414 0l2-2z" clip-rule="evenodd"/>
            </svg>
          </div>
          <h3 class="font-semibold text-text">Ticket Value</h3>
        </div>
        <p class="text-text-muted text-sm">Vehicles have a ticket value. If destroyed, your team loses that many tickets.</p>
      </div>
      <div class="p-4 bg-bg-card rounded-lg border border-border">
        <div class="flex items-center gap-3 mb-2">
          <div class="w-10 h-10 bg-yellow-500/20 rounded flex items-center justify-center">
            <svg class="w-5 h-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"/>
            </svg>
          </div>
          <h3 class="font-semibold text-text">Respawn Timer</h3>
        </div>
        <p class="text-text-muted text-sm">When destroyed, a replacement vehicle spawns after a certain time. If flipped, the vehicle burns - pay attention to where you drive!</p>
      </div>
    </div>
  </section>

  <!-- Tips -->
  <section class="mb-12 p-4 bg-accent/10 rounded-lg border border-accent/30">
    <h3 class="font-semibold text-accent mb-2">Tips</h3>
    <ul class="text-text-muted text-sm space-y-2">
      <li>- Stay on roads when possible - off-road driving significantly slows wheeled vehicles</li>
      <li>- Coordinate with your team before taking valuable assets like MBTs</li>
      <li>- Always check your surroundings before exiting a vehicle in combat</li>
      <li>- Use AP rounds against armor, HE/HEAT against infantry</li>
      <li>- Don't abandon vehicles - they will burn and your team loses tickets</li>
    </ul>
  </section>

  <!-- Lightbox Modal -->
  <div
    id="lightbox"
    class="fixed inset-0 z-50 hidden items-center justify-center bg-black/90 backdrop-blur-sm"
  >
    <button
      id="lightbox-close"
      type="button"
      class="absolute top-4 right-4 w-10 h-10 flex items-center justify-center rounded-full bg-bg-card/80 hover:bg-bg-card text-text hover:text-accent transition-colors z-10"
      aria-label="Close"
    >
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
    <div class="relative max-w-4xl max-h-[90vh] p-4">
      <img
        id="lightbox-image"
        src=""
        alt=""
        class="max-w-full max-h-[80vh] object-contain rounded-lg shadow-2xl"
      />
      <p id="lightbox-title" class="text-center text-text mt-4 text-lg font-semibold"></p>
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const lightbox = document.getElementById('lightbox');
      const lightboxImage = document.getElementById('lightbox-image') as HTMLImageElement;
      const lightboxTitle = document.getElementById('lightbox-title');
      const lightboxClose = document.getElementById('lightbox-close');

      // Open lightbox
      document.querySelectorAll('[data-lightbox-trigger]').forEach(trigger => {
        trigger.addEventListener('click', (e) => {
          const target = e.currentTarget as HTMLElement;
          const imageSrc = target.dataset.image;
          const title = target.dataset.title;

          if (lightboxImage && imageSrc) {
            lightboxImage.src = imageSrc;
            lightboxImage.alt = title || '';
          }
          if (lightboxTitle) {
            lightboxTitle.textContent = title || '';
          }
          if (lightbox) {
            lightbox.classList.remove('hidden');
            lightbox.classList.add('flex');
            document.body.style.overflow = 'hidden';
          }
        });
      });

      // Close lightbox
      const closeLightbox = () => {
        if (lightbox) {
          lightbox.classList.add('hidden');
          lightbox.classList.remove('flex');
          document.body.style.overflow = '';
        }
      };

      lightboxClose?.addEventListener('click', closeLightbox);
      lightbox?.addEventListener('click', (e) => {
        if (e.target === lightbox) closeLightbox();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeLightbox();
      });
    });
  </script>
</BaseLayout>
