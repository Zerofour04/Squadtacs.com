---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const factions = await getCollection('factions');
const sortedFactions = factions.sort((a, b) => a.data.title.localeCompare(b.data.title));

const pageTitle = 'All 17 Squad Factions Guide';
const pageDescription = 'Complete guide to all 17 Squad factions: USA, USMC, BAF, RGF, PLA, MEA and more. Weapons, vehicles, uniforms and tactics for each team.';

const sideInfo = {
  BLUFOR: {
    title: 'BLUFOR Factions',
    description: 'Consisting of NATO members and Western-aligned countries, conventional BLUFOR factions are high-tech militaries outfitted with modern equipment of western design.',
    color: 'blufor',
  },
  PAC: {
    title: 'PAC Factions',
    description: 'Consisting of significant military, geopolitical, and technological rivals to the Western-aligned countries in the Pacific regions.',
    color: 'pac',
  },
  REDFOR: {
    title: 'REDFOR Factions',
    description: 'Consisting of significant and direct threats to the Western-aligned countries. They use Soviet and Russian weapon platforms.',
    color: 'redfor',
  },
  INDEPENDENT: {
    title: 'INDEPENDENT Factions',
    description: 'Non-aligned armed forces that can engage both BLUFOR and REDFOR.',
    color: 'independent',
  },
} as const;

const unconventionalIds = ['ins', 'imf', 'wpmc', 'crf'];

const unitWithFlagImages: Record<string, string> = {
  usa: '/img/units/unitwithflag/US_Rifleman_Flag.webp',
  usmc: '/img/units/unitwithflag/USMC_Rifleman_Flag.webp',
  baf: '/img/units/unitwithflag/GB_Rifleman_Flag.webp',
  caf: '/img/units/unitwithflag/CAF_Rifleman_Flag.webp',
  adf: '/img/units/unitwithflag/AUS_Rifleman_Flag.webp',
  afu: '/img/units/unitwithflag/AFU_TeamImage.webp',
  rgf: '/img/units/unitwithflag/RUS_Rifleman_Flag.webp',
  vdv: '/img/units/unitwithflag/VDV_Rifleman_Flag.webp',
  pla: '/img/units/unitwithflag/PLAImage.webp',
  planmc: '/img/units/unitwithflag/PLANMC_Rifleman_Flag.webp',
  plaagf: '/img/units/unitwithflag/PLAAGF_Rifleman_Flag.webp',
  mea: '/img/units/unitwithflag/MEA_Rifleman_Flag.webp',
  tlf: '/img/units/unitwithflag/TLFTeamImage_desert.webp',
  imf: '/img/units/unitwithflag/IMF_TeamImage.webp',
  ins: '/img/units/unitwithflag/INS_Rifleman_Flag.webp',
  wpmc: '/img/units/unitwithflag/WPMC_Rifleman_Flag.webp',
  crf: '/img/units/unitwithflag/CRF_TeamImage.webp',
};

const sides = ['BLUFOR', 'PAC', 'REDFOR', 'INDEPENDENT'] as const;

const schemaData = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Squad Game Factions',
  description: pageDescription,
  numberOfItems: sortedFactions.length,
  itemListElement: sortedFactions.map((faction, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    item: {
      '@type': 'Organization',
      name: faction.data.title,
      alternateName: faction.data.shortName,
      description: faction.data.description,
      url: `https://squadtacs.com/factions/${faction.id}`,
    },
  })),
};
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

  <div class="mb-10">
    <h1 class="font-display text-4xl font-bold text-text mb-3 uppercase tracking-wide">Squad Factions</h1>
    <p class="text-text-muted text-lg">All 17 playable factions in Squad with vehicles, weapons and tactics</p>
  </div>

  {sides.map((side) => {
    const sideFactions = sortedFactions.filter((f) => f.data.side === side);
    if (sideFactions.length === 0) return null;

    const conventional = sideFactions.filter((f) => !unconventionalIds.includes(f.id));
    const unconventional = sideFactions.filter((f) => unconventionalIds.includes(f.id));

    return (
      <section class="mb-14" aria-labelledby={`${side.toLowerCase()}-heading`}>
        <div class="mb-6">
          <h2 id={`${side.toLowerCase()}-heading`} class={`font-display text-2xl font-bold text-${sideInfo[side].color} mb-2`}>
            {sideInfo[side].title}
          </h2>
          <p class="text-text-muted text-sm max-w-3xl">{sideInfo[side].description}</p>
        </div>

        {conventional.length > 0 && (
          <div class="mb-6">
            <h3 class="text-xs uppercase tracking-widest text-text-dim mb-4 pl-1">Conventional</h3>
            <ul class="grid gap-2" role="list">
              {conventional.map((faction) => (
                <li>
                  <a
                    href={`/factions/${faction.id}`}
                    class="group flex items-center gap-4 p-3 bg-bg-card/50 hover:bg-bg-card border border-border/50 hover:border-border rounded-lg transition-all"
                    title={`${faction.data.title} - ${faction.data.description}`}
                  >
                    {unitWithFlagImages[faction.id] && (
                      <img
                        src={unitWithFlagImages[faction.id]}
                        alt={`${faction.data.shortName} soldier`}
                        class="w-12 h-12 object-cover rounded shadow-sm"
                        loading="lazy"
                        width="48"
                        height="48"
                      />
                    )}
                    <div>
                      <span class="text-text group-hover:text-accent transition-colors font-medium block">
                        {faction.data.title}
                      </span>
                      <span class="text-text-dim text-xs">{faction.data.shortName}</span>
                    </div>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}

        {unconventional.length > 0 && (
          <div>
            <h3 class="text-xs uppercase tracking-widest text-text-dim mb-4 pl-1">Unconventional</h3>
            <ul class="grid gap-2" role="list">
              {unconventional.map((faction) => (
                <li>
                  <a
                    href={`/factions/${faction.id}`}
                    class="group flex items-center gap-4 p-3 bg-bg-card/50 hover:bg-bg-card border border-border/50 hover:border-border rounded-lg transition-all"
                    title={`${faction.data.title} - ${faction.data.description}`}
                  >
                    {unitWithFlagImages[faction.id] && (
                      <img
                        src={unitWithFlagImages[faction.id]}
                        alt={`${faction.data.shortName} soldier`}
                        class="w-12 h-12 object-cover rounded shadow-sm"
                        loading="lazy"
                        width="48"
                        height="48"
                      />
                    )}
                    <div>
                      <span class="text-text group-hover:text-accent transition-colors font-medium block">
                        {faction.data.title}
                      </span>
                      <span class="text-text-dim text-xs">{faction.data.shortName}</span>
                    </div>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </section>
    );
  })}

  {sortedFactions.length === 0 && (
    <div class="p-8 bg-bg-card rounded-lg border border-border text-center">
      <p class="text-text-muted mb-2">No factions yet</p>
      <p class="text-sm text-text-dim">Add markdown files to <code class="text-accent">src/content/factions/</code></p>
    </div>
  )}
</BaseLayout>
