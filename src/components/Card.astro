---
interface Props {
  title: string;
  description?: string;
  href: string;
  badge?: string;
  badgeColor?: 'blufor' | 'redfor' | 'independent' | 'pac' | 'primary' | 'accent';
}

const { title, description, href, badge, badgeColor = 'primary' } = Astro.props;

const badgeColors = {
  blufor: 'bg-blufor/15 text-blufor border border-blufor/30',
  redfor: 'bg-redfor/15 text-redfor border border-redfor/30',
  independent: 'bg-independent/15 text-independent border border-independent/30',
  pac: 'bg-pac/15 text-pac border border-pac/30',
  primary: 'bg-primary/15 text-primary-light border border-primary/30',
  accent: 'bg-accent/15 text-accent border border-accent/30',
};
---

<a
  href={href}
  class="group block p-5 bg-bg-card rounded-lg border border-border hover:border-primary/50 transition-all duration-300 relative overflow-hidden"
>
  <div class="absolute inset-0 bg-gradient-to-br from-primary/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>

  <div class="relative">
    <div class="flex items-start justify-between gap-3">
      <h3 class="font-display text-lg font-semibold text-text group-hover:text-accent transition-colors uppercase tracking-wide">
        {title}
      </h3>
      {badge && (
        <span class={`text-[10px] font-display font-semibold px-2 py-1 rounded uppercase tracking-wider ${badgeColors[badgeColor]}`}>
          {badge}
        </span>
      )}
    </div>
    {description && (
      <p class="mt-2 text-sm text-text-muted line-clamp-2 leading-relaxed">{description}</p>
    )}

    <div class="mt-4 flex items-center text-xs text-text-dim group-hover:text-primary-light transition-colors">
      <span class="font-medium uppercase tracking-wider">Learn more</span>
      <svg class="w-4 h-4 ml-1 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </div>
  </div>
</a>
