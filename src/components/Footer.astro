---
const currentYear = new Date().getFullYear();

const links = [
  { label: 'Home', href: '/' },
  { label: 'Guides', href: '/guides' },
  { label: 'Factions', href: '/factions' },
  { label: 'Classes', href: '/classes' },
  { label: 'Credits & License', href: '/credits' },
];

const externalLinks = [
  { label: 'Official Squad Website', href: 'https://joinsquad.com' },
  { label: 'Squad Wiki', href: 'https://squad.fandom.com' },
  { label: 'Reddit', href: 'https://reddit.com/r/joinsquad' },
];
---

<footer class="bg-bg-base border-t border-border mt-16">
  <div class="max-w-6xl mx-auto px-6 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div>
        <div class="flex items-center gap-3 mb-4">
          <div class="w-10 h-10 bg-gradient-to-br from-primary to-primary-dark rounded-lg flex items-center justify-center border border-primary-light/20">
            <span class="font-display text-white font-bold text-sm tracking-wider">SQ</span>
          </div>
          <div>
            <span class="font-display text-lg font-semibold text-text uppercase tracking-wide block">Squad Guides</span>
            <span class="text-[10px] text-text-dim uppercase tracking-widest">Tactical Wiki</span>
          </div>
        </div>
        <p class="text-sm text-text-muted leading-relaxed">
          Community-driven guides for Squad players of all skill levels.
        </p>
      </div>

      <div>
        <h3 class="font-display text-xs font-semibold text-text uppercase tracking-[0.2em] mb-4">Navigation</h3>
        <ul class="space-y-2">
          {links.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-text-muted hover:text-accent transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="font-display text-xs font-semibold text-text uppercase tracking-[0.2em] mb-4">Resources</h3>
        <ul class="space-y-2">
          {externalLinks.map((link) => (
            <li>
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="text-sm text-text-muted hover:text-accent transition-colors inline-flex items-center gap-1.5"
              >
                {link.label}
                <svg class="w-3 h-3 text-text-dim" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="mt-10 pt-6 border-t border-border/50">
      <div class="flex flex-col md:flex-row justify-between items-center gap-4 mb-4">
        <p class="text-sm text-text-dim">
          &copy; {currentYear} Squad Guides. Not affiliated with Offworld Industries.
        </p>
        <div class="flex items-center gap-2 text-xs text-text-dim">
          <span>Built with</span>
          <span class="text-accent">Astro</span>
          <span>&</span>
          <span class="text-primary-light">Tailwind</span>
        </div>
      </div>

      <div class="flex flex-col md:flex-row justify-between items-center gap-3 pt-4 border-t border-border/30">
        <p class="text-xs text-text-dim">
          Content adapted from
          <a href="https://squad.fandom.com" target="_blank" rel="noopener noreferrer" class="text-primary-light hover:text-accent transition-colors">Squad Wiki</a>
          under
          <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/" target="_blank" rel="noopener noreferrer" class="text-primary-light hover:text-accent transition-colors">CC BY-NC-SA</a>
        </p>
        <a href="/credits" class="text-xs text-text-dim hover:text-accent transition-colors inline-flex items-center gap-1">
          View full credits & license
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</footer>
