---
import { getCollection } from 'astro:content';

interface SidebarSection {
  title: string;
  items: { label: string; href: string }[];
}

const currentPath = Astro.url.pathname;

// Determine which section we're in based on URL
const isGuides = currentPath.startsWith('/guides');
const isWiki = currentPath.startsWith('/wiki') || currentPath.startsWith('/factions') || currentPath.startsWith('/classes') || currentPath.startsWith('/weapons') || currentPath.startsWith('/vehicles') || currentPath.startsWith('/game-modes');
const isMaps = currentPath.startsWith('/maps');

// Get content collections for dynamic sidebar
const guides = await getCollection('guides');
const maps = await getCollection('maps');
const factions = await getCollection('factions');

// Sort guides by order
const sortedGuides = guides.sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

// Group guides by category
const basicGuides = sortedGuides.filter(g => g.data.category === 'basics');
const advancedGuides = sortedGuides.filter(g => g.data.category === 'advanced');
const tacticGuides = sortedGuides.filter(g => g.data.category === 'tactics');

// Sort maps alphabetically
const sortedMaps = maps.sort((a, b) => a.data.title.localeCompare(b.data.title));

// Build sections based on current area
let sections: SidebarSection[] = [];

if (isGuides) {
  // GUIDES SIDEBAR
  sections = [
    {
      title: 'Basics',
      items: basicGuides.map(g => ({ label: g.data.title, href: `/guides/${g.id}` })),
    },
    {
      title: 'Advanced',
      items: advancedGuides.map(g => ({ label: g.data.title, href: `/guides/${g.id}` })),
    },
    {
      title: 'Tactics',
      items: tacticGuides.map(g => ({ label: g.data.title, href: `/guides/${g.id}` })),
    },
  ].filter(s => s.items.length > 0);
} else if (isWiki) {
  // WIKI SIDEBAR
  sections = [
    {
      title: 'Forces',
      items: [
        { label: 'Factions', href: '/factions' },
        { label: 'Classes', href: '/classes' },
      ],
    },
    {
      title: 'Arsenal',
      items: [
        { label: 'Weapons', href: '/weapons' },
        { label: 'Vehicles', href: '/vehicles' },
      ],
    },
    {
      title: 'Gameplay',
      items: [
        { label: 'Game Modes', href: '/game-modes' },
      ],
    },
  ];
} else if (isMaps) {
  // MAPS SIDEBAR - Group by region/type or just alphabetical
  sections = [
    {
      title: 'All Maps',
      items: sortedMaps.map(m => ({ label: m.data.title, href: `/maps/${m.id}` })),
    },
  ];
}

// Fallback if no specific section
if (sections.length === 0) {
  sections = [
    {
      title: 'Quick Links',
      items: [
        { label: 'Guides', href: '/guides' },
        { label: 'Wiki', href: '/wiki' },
        { label: 'Maps', href: '/maps' },
      ],
    },
  ];
}

// Current section label for header
const sectionLabel = isGuides ? 'Guides' : isWiki ? 'Wiki' : isMaps ? 'Maps' : 'Navigation';
---

<aside class="hidden lg:block fixed left-0 top-16 bottom-0 w-64 bg-bg-base border-r border-border">
  <div class="h-full overflow-y-auto p-4 pb-24">
    <!-- Section Header -->
    <div class="mb-4 pb-3 border-b border-border px-3">
      <a
        href={isGuides ? '/guides' : isWiki ? '/wiki' : isMaps ? '/maps' : '/'}
        class="font-display text-sm font-semibold uppercase tracking-widest text-accent hover:text-accent-light transition-colors"
      >
        {sectionLabel}
      </a>
    </div>

    {sections.map((section, index) => (
      <div class:list={["mb-6", index > 0 && "pt-4 border-t border-border/50"]}>
        <h3 class="font-display text-xs font-semibold uppercase tracking-widest text-text-dim mb-3 px-3">
          {section.title}
        </h3>
        <ul class="space-y-1">
          {section.items.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={[
                  'block px-3 py-2 text-sm transition-all duration-200 border-l-2 -ml-[2px]',
                  currentPath === item.href || currentPath.startsWith(item.href + '/')
                    ? 'text-accent border-accent font-medium bg-accent/5'
                    : 'text-text-muted hover:text-text border-transparent hover:border-text-dim',
                ]}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>

  <button
    data-search-trigger
    class="absolute bottom-0 left-0 right-0 p-4 border-t border-border bg-bg-base hover:bg-bg-hover transition-colors text-left cursor-pointer"
  >
    <div class="text-xs text-text-dim">
      <span class="font-display uppercase tracking-wider">Quick Access</span>
      <div class="mt-2 flex gap-2 items-center">
        <kbd class="px-1.5 py-0.5 bg-bg-card rounded text-text-muted border border-border">Ctrl</kbd>
        <span class="text-text-muted">+</span>
        <kbd class="px-1.5 py-0.5 bg-bg-card rounded text-text-muted border border-border">K</kbd>
        <span class="text-text-muted ml-1">Search</span>
      </div>
    </div>
  </button>
</aside>
